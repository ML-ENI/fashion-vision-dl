{
  "preparation_version": "1.0.0",
  "target": "product_type_name",
  "include_product_groups": [
    "Garment Upper body",
    "Garment Lower body",
    "Garment Full body"
  ],
  "include_classes": [
    "Blazer",
    "Blouse",
    "Bodysuit",
    "Cardigan",
    "Coat",
    "Hoodie",
    "Jacket",
    "Outdoor Waistcoat",
    "Polo shirt",
    "Shirt",
    "Sweater",
    "T-shirt",
    "Tailored Waistcoat",
    "Top",
    "Vest top",
    "Leggings/Tights",
    "Outdoor trousers",
    "Shorts",
    "Skirt",
    "Trousers",
    "Costumes",
    "Dress",
    "Dungarees",
    "Garment Set",
    "Jumpsuit/Playsuit",
    "Outdoor overall"
  ],
  "min_side": 64,
  "min_class_images": 3,
  "image_size": 224,
  "jpeg_quality": 90,
  "padding_rgb": [
    255,
    255,
    255
  ],
  "seed": 42,
  "val_size": 0.15,
